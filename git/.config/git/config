[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[core]
	pager = delta
	editor = nvim

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Dracula

[alias]
	co = checkout
	br = branch
	sw = switch
	st = status -sb
	cm = commit -m
	undo = reset --soft HEAD~1
	wip = !git add -A && git commit -m 'wip'
	lg = log --oneline --graph --decorate --all
	last = log -1 HEAD
	amend = commit --amend --no-edit
	unstage = restore --staged
