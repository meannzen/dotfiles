// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "helix_mode": false,
  "minimum_contrast_for_highlights": 32.0,
  "show_wrap_guides": true,
  "theme": "Gruvbox Dark Soft",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "sonnet"
      },
      "type": "registry",
    },
  },
  "show_edit_predictions": false,
  "minimap": {
    "thumb_border": "right_open",
  },
  "centered_layout": {
    "left_padding": 0.19999980926513672,
  },
  "bottom_dock_layout": "contained",
  "debugger": {
    "button": true,
  },
  "search": {
    "case_sensitive": false,
    "whole_word": false,
    "button": true,
  },
  "zoomed_padding": true,
  "preview_tabs": {
    "enabled": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show": true,
  },
  "scrollbar": {
    "show": "never",
    "search_results": true,
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
  },
  "on_last_window_closed": "quit_app",
  "status_bar": {
    "active_language_button": false,
    "cursor_position_button": true,
  },
  "terminal": {
    "button": true,
  },
  "diagnostics": {
    "button": true,
  },
  "title_bar": {
    "show_sign_in": false,
    "show_user_picture": false,
    "show_onboarding_banner": false,
    "show_branch_name": false,
    "show_project_items": false,
  },
  "project_panel": {
    "dock": "left",
    "button": true,
  },
  "toolbar": {
    "breadcrumbs": false,
    "code_actions": false,
    "agent_review": false,
    "selections_menu": false,
    "quick_actions": false,
  },
  "cursor_shape": "bar",
  "agent_buffer_font_size": 14.0,
  "buffer_font_weight": 500.0,
  "ui_font_weight": 500.0,
  "ui_font_family": "SF Mono Terminal",
  "buffer_font_family": "Noto Sans",
  "icon_theme": "Material Icon Theme",
  "agent": {
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "x_ai",
      "model": "grok-4.3",
    },
    "model_parameters": [],
  },
  "base_keymap": "VSCode",
  "ui_font_size": 17.0,
  "buffer_font_size": 18.0,
  "vim_mode": true,
  "languages": {
    "CSharp": {
      "language_servers": ["roslyn", "!omnisharp"],
    },
  },
  "lsp": {
    "roslyn": {
      "initialization_options": {
        "RoslynExtensionsOptions": {
          "enableAnalyzersSupport": true,
          "enableImportCompletion": true,
        },
      },
    },
  },
}
